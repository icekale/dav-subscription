<view class="page">
  <view class="card">
    <view class="row" style="justify-content:space-between;align-items:center">
      <view class="card-title" style="margin-bottom:0">已订阅</view>
      <view class="filter-tabs">
        <view class="filter-tab {{view === 'all' ? 'selected' : ''}}" data-view="all" bindtap="switchView">全部</view>
        <view class="filter-tab {{view === 'kol' ? 'selected' : ''}}" data-view="kol" bindtap="switchView">大V</view>
        <view class="filter-tab {{view === 'combo' ? 'selected' : ''}}" data-view="combo" bindtap="switchView">组合</view>
      </view>
    </view>
    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{shown.length === 0}}" class="empty">
      {{view === 'combo' ? '还没有订阅任何组合' : '还没有订阅任何大V'}}
      <view><button class="btn btn-primary" bindtap="goHome">去发现大V</button></view>
    </view>
    <view wx:else>
      <view class="kol-item" wx:for="{{shown}}" wx:key="id">
        <image wx:if="{{item.avatar_url}}" class="avatar" src="{{item.avatar_url}}" mode="aspectFill"></image>
        <view wx:else class="avatar">{{item.name[0]}}</view>
        <view class="kol-info" data-id="{{item.id}}" bindtap="goKol">
          <view class="row">
            <text class="kol-name">{{item.name}}</text>
            <text class="tag">{{item.platform_label}}</text>
            <text wx:if="{{item.favorite}}" class="star-tag">★ 特别关注</text>
            <text wx:if="{{item.secondary}}" class="sec-tag">🔕 次要</text>
          </view>
          <view class="kol-desc">{{item.category_name || '未分类'}}</view>
          <view wx:if="{{item.platform === 'xueqiu'}}" class="sub-type-row">
            <view
              wx:for="{{subTypes}}"
              wx:for-item="st"
              wx:key="value"
              class="sub-type-chip {{item.subscribe_type === st.value ? 'selected' : ''}}"
              data-id="{{item.id}}"
              data-type="{{st.value}}"
              catchtap="changeSubType">{{st.label}}</view>
          </view>
        </view>
        <view class="item-actions">
          <view class="fav-btn {{item.secondary ? 'sec-on' : ''}}" data-id="{{item.id}}" catchtap="toggleSecondary">{{item.secondary ? '🔕' : '🔔'}}</view>
          <view class="fav-btn {{item.favorite ? 'fav-on' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{item.favorite ? '★' : '☆'}}</view>
          <button class="btn-sub subscribed" data-id="{{item.id}}" bindtap="unsubscribe">退订</button>
        </view>
      </view>
    </view>
  </view>
</view>
