.kol-name { font-size: 32rpx; font-weight: 600; color: var(--text-strong); }
.kol-desc { font-size: 24rpx; color: var(--text-muted); margin-top: 8rpx; }
.sub-type-box {
  margin-top: 24rpx;
  padding: 20rpx 0 0;
  border-top: 1rpx solid var(--line);
}
.sub-type-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}
.sub-type-switches { display: flex; gap: 16rpx; }
.sub-type-chip {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-strong);
  color: var(--text-muted);
  font-size: 24rpx;
  background: var(--surface);
}
.sub-type-chip.selected {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 500;
}
.fav-row { margin-top: 20rpx; }
.fav-btn {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-strong);
  color: var(--text-muted);
  font-size: 24rpx;
  background: var(--surface);
}
.fav-btn.fav-on {
  background: rgba(250, 204, 21, 0.12);
  border-color: rgba(202, 138, 4, 0.4);
  color: #b45309;
}
/* 次要铃铛：默认 🔔 黄色（正常推送），已设次要 🔕 灰色（降频） */
.fav-btn.sec-btn {
  color: #b45309;
  border-color: rgba(202, 138, 4, 0.4);
  background: rgba(250, 204, 21, 0.12);
}
.fav-btn.sec-on {
  background: rgba(100, 116, 139, 0.16);
  border-color: rgba(100, 116, 139, 0.45);
  color: #475569;
}

/* ---- 组合：状态 / 持仓 / 净值曲线 ---- */
.quote-grid { display: flex; gap: 24rpx; margin-top: 16rpx; }
.quote-item { flex: 1; }
.quote-label { font-size: 22rpx; color: var(--text-muted); }
.quote-value { font-size: 32rpx; font-weight: 600; color: var(--text-strong); margin-top: 4rpx; }
.quote-value.small { font-size: 22rpx; font-weight: 400; color: var(--text-muted); }
/* A股惯例：红涨绿跌 */
.quote-value.up { color: #e64340; }
.quote-value.down { color: #07c160; }

.holding-row { padding: 14rpx 0; }
.holding-name { font-size: 26rpx; color: var(--text-strong); }
.holding-weight { font-size: 26rpx; font-weight: 600; color: var(--text-muted); }
.holding-delta { font-weight: 500; }
.holding-delta.up { color: #e64340; }
.holding-delta.down { color: #07c160; }
.weight-bar {
  margin-top: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  overflow: hidden;
}
.weight-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--accent);
  opacity: 0.85;
}
.snapshot-time { margin-top: 12rpx; font-size: 22rpx; color: var(--text-muted); }

.nav-latest { font-size: 30rpx; font-weight: 600; color: var(--text-strong); }
.nav-date { font-size: 22rpx; color: var(--text-muted); }
.nav-chart { width: 100%; height: 360rpx; margin-top: 12rpx; }
