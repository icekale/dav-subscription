<view class="page">
  <view class="card" wx:if="{{kol}}">
      <view class="row" style="justify-content:space-between">
      <view class="row">
        <image wx:if="{{kol.avatar_url}}" class="avatar" src="{{kol.avatar_url}}" mode="aspectFill"></image>
        <view wx:else class="avatar">{{kol.name[0]}}</view>
        <view style="margin-left:24rpx">
          <view class="row">
            <text class="kol-name">{{kol.name}}</text>
            <text class="tag">{{kol.platform_label}}</text>
          </view>
          <view class="kol-desc">ID：{{kol.external_id}}{{kol.category_name ? ' · ' + kol.category_name : ''}}</view>
        </view>
      </view>
      <button class="btn-sub {{kol.subscribed ? 'subscribed' : ''}}" bindtap="toggleSubscribe">
        {{kol.subscribed ? '已订阅' : '订阅'}}
      </button>
    </view>
    <view wx:if="{{kol.subscribed && kol.platform === 'xueqiu'}}" class="sub-type-box">
      <view class="sub-type-label">订阅内容</view>
      <view class="sub-type-switches">
        <view
          wx:for="{{subTypes}}"
          wx:key="value"
          class="sub-type-chip {{kol.subscribe_type === item.value ? 'selected' : ''}}"
          data-type="{{item.value}}"
          bindtap="changeSubType">{{item.label}}</view>
      </view>
    </view>
    <view wx:if="{{kol.subscribed}}" class="fav-row">
      <view class="fav-btn {{kol.favorite ? 'fav-on' : ''}}" bindtap="toggleFavorite">
        {{kol.favorite ? '★ 已特别关注（优先推送）' : '☆ 设为特别关注（优先推送）'}}
      </view>
    </view>
    <view wx:if="{{kol.subscribed}}" class="fav-row">
      <view class="fav-btn sec-btn {{kol.secondary ? 'sec-on' : ''}}" bindtap="toggleSecondary">
        {{kol.secondary ? '🔕 已设为次要（降频推送）' : '🔔 设为次要（合并摘要推送）'}}
      </view>
    </view>
  </view>
  <view wx:if="{{kol.platform === 'combination'}}">
    <view class="card" wx:if="{{quoteDisplay}}">
      <view class="card-title">组合状态</view>
      <view class="quote-grid">
        <view class="quote-item">
          <view class="quote-label">净值</view>
          <view class="quote-value">{{quoteDisplay.net}}</view>
        </view>
        <view class="quote-item">
          <view class="quote-label">今日涨跌</view>
          <view class="quote-value {{quoteDisplay.dayClass}}">{{quoteDisplay.day}}</view>
        </view>
        <view class="quote-item">
          <view class="quote-label">快照</view>
          <view class="quote-value small">{{quoteDisplay.time || '—'}}</view>
        </view>
      </view>
    </view>
    <view class="card">
      <view class="card-title">当前持仓</view>
      <view wx:if="{{holdings.length === 0}}" class="empty">暂无持仓数据（订阅后自动抓取）</view>
      <view wx:else>
        <view class="holding-row" wx:for="{{holdings}}" wx:key="symbol">
          <view class="row" style="justify-content:space-between">
            <text class="holding-name">{{item.name}}</text>
            <text class="holding-weight">{{item.weight}}%<text wx:if="{{item.delta}}" class="holding-delta {{item.deltaClass}}"> {{item.delta}}</text></text>
          </view>
          <view class="weight-bar"><view class="weight-fill" style="width:{{item.weight}}%"></view></view>
        </view>
        <view class="snapshot-time" wx:if="{{holdingsUpdatedAt}}">更新于 {{holdingsUpdatedAt}}</view>
      </view>
    </view>
    <view class="card">
      <view class="card-title">净值走势</view>
      <view wx:if="{{navSeries.length < 2}}" class="empty">暂无净值数据（订阅后自动抓取）</view>
      <view wx:else>
        <view class="row" style="justify-content:space-between;align-items:baseline">
          <text class="nav-latest">最新 {{navSeries[navSeries.length - 1].value}}</text>
          <text class="nav-date">{{navSeries[navSeries.length - 1].date}}{{navHint}}</text>
        </view>
        <canvas type="2d" id="navChart" class="nav-chart"></canvas>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="card-title">最近动态</view>
    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{posts.length === 0}}" class="empty">暂无动态</view>
    <view wx:else>
      <view class="post-item" wx:for="{{posts}}" wx:key="id">
        <view class="post-header">
          <image wx:if="{{item.avatar_url}}" class="avatar sm" src="{{item.avatar_url}}" mode="aspectFill"></image>
          <view wx:else class="avatar sm">{{item.kol_name[0]}}</view>
          <view style="margin-left:20rpx">
            <view class="post-name">{{item.kol_name}}</view>
            <view class="post-time">{{item.published_at}}</view>
          </view>
        </view>
        <view wx:if="{{item.title}}" class="post-title">{{item.title}}</view>
        <view class="post-content">{{item.content || '（无正文）'}}</view>
        <view class="post-meta">
          <text style="margin-left:0">{{item.platform_label}}</text>
          <text class="post-link" data-url="{{item.url}}" bindtap="copyLink">查看原文 →</text>
        </view>
      </view>
    </view>
  </view>
</view>
