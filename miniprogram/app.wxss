/* 设计 token：对齐后台 design-tokens（px -> rpx，以 375 设计稿为基准） */
page {
  --bg: #f5f5f7;
  --surface: #ffffff;
  --surface-soft: rgba(255, 255, 255, 0.84);
  --text: #1d1d1f;
  --text-strong: #222c3c;
  --text-muted: #6e6e73;
  --text-faint: #8b92a1;
  --line: rgba(12, 18, 34, 0.08);
  --line-strong: rgba(12, 18, 34, 0.14);
  --accent: #1677ff;
  --accent-strong: #155eef;
  --accent-soft: rgba(22, 119, 255, 0.1);
  --danger: #dc2626;
  --success: #16a34a;

  --radius-card: 40rpx;
  --radius-control: 24rpx;
  --radius-pill: 999rpx;
  --shadow-panel: 0 12rpx 60rpx rgba(15, 23, 42, 0.05);

  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input { box-sizing: border-box; }
button::after { border: none; }

.page { min-height: 100vh; padding: 24rpx; }
.card {
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-panel);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 20rpx;
}
.card-meta { font-size: 24rpx; color: var(--text-muted); margin-top: 6rpx; }
.eyebrow {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--accent);
  text-transform: uppercase;
}
.row { display: flex; align-items: center; }
.muted { color: var(--text-muted); }
.faint { color: var(--text-faint); }

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 68rpx;
}
.btn-primary {
  background: linear-gradient(180deg, #2a86ff, var(--accent));
  color: #fff;
}
.btn-ghost {
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  color: var(--text-strong);
}
.btn-sub {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(180deg, #2a86ff, var(--accent));
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}
.btn-sub.subscribed { background: var(--surface); color: var(--text-muted); border: 1rpx solid var(--line-strong); }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: var(--radius-pill);
  padding: 4rpx 20rpx;
  margin-left: 12rpx;
}

/* 头像 */
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #2a86ff, var(--accent));
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar.sm { width: 72rpx; height: 72rpx; font-size: 28rpx; }
.avatar.lg { width: 112rpx; height: 112rpx; font-size: 44rpx; }

/* 大V 行 */
.kol-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.kol-item:last-child { border-bottom: none; }
.kol-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.kol-name { font-size: 30rpx; font-weight: 600; color: var(--text-strong); }
.kol-desc { font-size: 24rpx; color: var(--text-muted); margin-top: 8rpx; }

/* 帖子 */
.post-item { padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.post-item:last-child { border-bottom: none; }
.post-header { display: flex; align-items: center; }
.post-name { font-size: 28rpx; font-weight: 600; color: var(--text-strong); }
.post-time { font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; }
.post-title { font-size: 30rpx; font-weight: 700; margin-top: 20rpx; }
.post-content { font-size: 28rpx; color: var(--text); margin-top: 12rpx; line-height: 1.7; word-break: break-all; }
.post-meta { display: flex; align-items: center; flex-wrap: wrap; margin-top: 16rpx; font-size: 24rpx; color: var(--text-muted); }
.post-link { color: var(--accent); margin-left: auto; }

/* 输入 */
.input {
  height: 88rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-control);
  padding: 0 28rpx;
  font-size: 28rpx;
}
.form-label { font-size: 26rpx; font-weight: 500; color: var(--text-strong); margin-bottom: 12rpx; }
.form-item { margin-bottom: 28rpx; }

/* 空态 */
.empty {
  text-align: center;
  color: var(--text-muted);
  padding: 100rpx 40rpx;
  font-size: 26rpx;
}
.empty .btn { margin-top: 32rpx; }

/* 平台筛选 */
.platform-tabs { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.platform-tab {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-pill);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  color: var(--text);
  font-size: 26rpx;
}
.platform-tab.selected { background: var(--accent); border-color: var(--accent); color: #fff; }

/* 菜单 */
.menu-card { overflow: hidden; }
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 30rpx;
  color: var(--text);
  background: var(--surface);
}
.menu-item:last-child { border-bottom: none; }
.menu-item.danger { color: var(--danger); }
.menu-arrow { color: var(--text-faint); }
