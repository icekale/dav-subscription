<view class="page">
  <view class="card user-card" wx:if="{{user}}">
    <view class="avatar lg">{{user.username[0]}}</view>
    <view style="margin-left:28rpx;flex:1">
      <view class="row">
        <text class="user-name">{{user.username}}</text>
        <text wx:if="{{user.is_admin}}" class="role-badge">管理员</text>
      </view>
      <view class="user-desc">订阅了 {{user.subscription_count}} 个大V · {{user.notify_enabled ? '推送已开启' : '推送已关闭'}}</view>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" bindtap="goSubs">
      <text>我的订阅</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <text>推送设置</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text>关于</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item danger" bindtap="doLogout">
      <text>退出登录</text>
    </view>
  </view>
</view>
