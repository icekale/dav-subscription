CONFIG_PATH=/app/config.yaml
DB_PATH=/data/dav.db
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
XUEQIU_COOKIE=
WEIBO_COOKIE=
WEIBO_TOKEN=
WEIBO_USERNAME=
WEIBO_PASSWORD=
RSSHUB_BASE=https://rsshub.app
# X 登录 Cookie 完整串（浏览器 F12 → Network → x.com 请求的 Cookie 复制整串）。
# 同时用于 RSSHub 抓取与 X 官方翻译：翻译走 X 内部 Grok，免 API key，质量同网页版
TWITTER_COOKIE=
# X 翻译用 Grok（xAI API，console.x.ai 申请）；留空则用免费翻译源
XAI_API_KEY=
XAI_MODEL=grok-2-latest
POLLING_INTERVAL_SECONDS=180
POLLING_PRIORITY_INTERVAL_SECONDS=60
POLLING_JITTER_SECONDS=30
POLLING_POSTS_RETENTION_DAYS=30
POLLING_PUSH_LOGS_RETENTION_DAYS=90
POLLING_DIGEST_INTERVAL_SECONDS=600
POLLING_SOURCE_PROBE_INTERVAL_SECONDS=600
POLLING_COOKIE_KEEPALIVE_INTERVAL_SECONDS=21600
POLLING_DAILY_REPORT_HOUR=20
NOTIFY_ON_START=true
# 日志级别：INFO / DEBUG（DEBUG 会记录每次 API 请求与 httpx 详情，便于排查）
LOG_LEVEL=INFO
# 日志文件：默认 /data/logs/app.log（随数据卷持久化，滚动 5MB×3，重启不丢）
LOG_FILE=/data/logs/app.log
WEB_ALLOW_REGISTER=true  # 是否允许注册（false 关闭注册入口）；注册始终需要邀请码
# 管理员告警总开关（默认 true）：置 false 时调度器照常抓取/推送订阅内容，
# 但不发任何管理员告警、不启动 TG/飞书 bot 长轮询。
# 本地开发/测试实例务必置 false，避免用生产 config 误发告警、抢生产 bot 轮询。
# 要完全静默（连抓取/推送都关）用 DAV_UI_ONLY=1
ALERTS_ENABLED=true
WEB_ADMIN_PASSWORD=
WEB_TOKEN_SECRET=
# 位于可信反向代理之后时置 true，登录/注册限流才信任 X-Forwarded-For
WEB_TRUST_PROXY=false
# 纯 UI 调试模式：置 1 时跳过调度器与机器人长连接（本地测试勿抢生产 bot 轮询）
DAV_UI_ONLY=0
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# compose 部署的自建 RSSHub 需要 auth_token（TWITTER_COOKIE 里 auth_token= 的值）
TWITTER_AUTH_TOKEN=
DOMAIN=your.domain.com
