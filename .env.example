CONFIG_PATH=/app/config.yaml
DB_PATH=/data/dav.db
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_NAME=
# 可选：飞书个人机器人凭据加密密钥（Fernet 兼容的 32 字节 Base64）。
# 配置后用户在网页可「扫码创建个人机器人」（推送配额独立于共享应用）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 未配置则个人机器人入口显示不可用，共享机器人照常工作。更换密钥需用户重新绑定。
FEISHU_CREDENTIAL_KEY=
BARK_SERVER=
# 可选：系统级默认 Bark key（配置后系统告警也会发 Bark）；用户可各自在网页绑定自己的 key
BARK_KEY=
# 可选 LLM 摘要：配置 LLM_API_KEY 后，免打扰时段汇总会用 AI 生成要点（未配置则用普通列表汇总）。
# OpenAI 兼容接口（/chat/completions），可对接 OpenAI / DeepSeek / 本地 Ollama、vLLM 等
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
XUEQIU_COOKIE=
WEIBO_COOKIE=
WEIBO_TOKEN=
WEIBO_USERNAME=
WEIBO_PASSWORD=
# ima（腾讯知识库）网页登录 Cookie，扫码登录 ima.qq.com 后从请求头 x-ima-cookie 复制
IMA_COOKIE=
# ima OpenAPI 凭证（官方通道，取全文/原文下载链接）：登录 https://ima.qq.com/agent-interface 生成
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# X 登录 Cookie 完整串（浏览器 F12 → Network → x.com 请求的 Cookie 复制整串）。
# 用于直抓 X 官方接口与官方翻译（翻译走 X 内部 Grok，免 API key，质量同网页版）
TWITTER_COOKIE=
POLLING_INTERVAL_SECONDS=180
POLLING_PRIORITY_INTERVAL_SECONDS=60
POLLING_JITTER_SECONDS=30
POLLING_POSTS_RETENTION_DAYS=30
POLLING_PUSH_LOGS_RETENTION_DAYS=90
POLLING_DIGEST_INTERVAL_SECONDS=600
POLLING_SOURCE_PROBE_INTERVAL_SECONDS=600
POLLING_COOKIE_KEEPALIVE_INTERVAL_SECONDS=21600
POLLING_DAILY_REPORT_HOUR=20
NOTIFY_ON_START=true
# 日志级别：INFO / DEBUG（DEBUG 会记录每次 API 请求与 httpx 详情，便于排查）
LOG_LEVEL=INFO
# 日志文件：默认 /data/logs/app.log（随数据卷持久化，滚动 5MB×3，重启不丢）
LOG_FILE=/data/logs/app.log
WEB_ALLOW_REGISTER=true  # 是否允许注册（false 关闭注册入口）；注册始终需要邀请码
# 管理员告警总开关（默认 true）：置 false 时调度器照常抓取/推送订阅内容，
# 但不发任何管理员告警、不启动 TG/飞书 bot 长轮询。
# 本地开发/测试实例务必置 false，避免用生产 config 误发告警、抢生产 bot 轮询。
# 要完全静默（连抓取/推送都关）用 DAV_UI_ONLY=1
ALERTS_ENABLED=true
WEB_ADMIN_PASSWORD=
WEB_TOKEN_SECRET=
# 位于可信反向代理之后时置 true，登录/注册限流才信任 X-Forwarded-For。
# docker-compose.prod.yml（前面有 Caddy）默认 true；本地直连 8000 保持 false。
WEB_TRUST_PROXY=false
# 纯 UI 调试模式：置 1 时跳过调度器与机器人长连接（本地测试勿抢生产 bot 轮询）
DAV_UI_ONLY=0
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DOMAIN=your.domain.com
